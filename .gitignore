# ============================================================
# Lumia3D Core — .gitignore
# ============================================================

# Reference materials kept locally only (stlhub fork source, mockups, original zips)
_workspace/
.claude/

# ============================================================
# .NET
# ============================================================
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
*.cache
*.VC.db
*.VC.VC.opendb
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# Self-contained publish output
publish/
publish-*/
**/wwwroot-build/

# ============================================================
# JavaScript / Node / Vite
# ============================================================
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# Vite build output (we copy it into Lumia3DCore/wwwroot at publish time)
src/Lumia3DCore.Web/dist/

# Bundled webroot (generated during MSBuild)
src/Lumia3DCore/wwwroot/

# ============================================================
# IDEs / Editors
# ============================================================
.vs/
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# Installer output
# ============================================================
installer-output/
*.iss.bak

# ============================================================
# Logs and runtime data (should never end up in repo)
# ============================================================
*.log
fatal.log
crash-*.log
library.db
library.db.backup-*
library.db-journal
library.db-wal
library.db-shm

# ============================================================
# Sensitive
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
